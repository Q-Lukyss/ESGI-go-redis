# Copier en .env pour surcharger les valeurs par défaut de cmd/repl.
# cmd/wasm (Worker navigateur) ne lit pas ce fichier pour l'instant — voir
# TODO.md, phase 11 (config unifiée serveur/WASM).

# Fichier AOF (journal d'écritures en attente de compaction), relatif au dossier de travail.
BUFFER_FILE=buffer_persistant.txt
# Fichier snapshot (photo complète du state), relatif au dossier de travail.
STATE_FILE=state_persistant.json

# Fréquence de flush du buffer d'écritures vers l'AOF, en secondes.
WRITE_TO_BUFFER_INTERVAL=1
# Fréquence de snapshot + compaction de l'AOF, en minutes.
UPDATE_STATE_FROM_BUFFER_INTERVAL=2
# Fréquence du balayage des clés expirées (TTL), en secondes.
EXPIRY_SWEEP_INTERVAL=10
# TTL appliqué par défaut à un SET sans EX explicite, en secondes.
# 0 = désactivé : un SET sans EX reste persistant (comportement Redis standard).
DEFAULT_TTL_SECONDS=0
