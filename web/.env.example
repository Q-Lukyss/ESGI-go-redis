# Copier en .env pour surcharger la config du moteur WASM (Worker + OPFS).
# Toutes les variables sont optionnelles : un champ absent retombe sur
# core.DefaultConfig() côté Go (cf. ../.env.example pour l'équivalent natif,
# utilisé par cmd/repl).
#
# Chaîne de transmission : Vite lit ce fichier au build -> wasmClient.ts
# les passe en query string à l'URL du Worker -> goredis-worker.js les
# traduit en arguments CLI (go.argv) -> cmd/wasm/main.go les parse (flag).

# Fichiers OPFS (racine de l'origine du navigateur).
VITE_AOF_FILE=aof.log
VITE_SNAPSHOT_FILE=snapshot.json

# Fréquence de flush du buffer d'écritures vers l'AOF, en millisecondes.
VITE_FLUSH_INTERVAL_MS=1000
# Fréquence de snapshot + compaction de l'AOF, en millisecondes.
VITE_SNAPSHOT_INTERVAL_MS=120000
# Fréquence du balayage des clés expirées (TTL), en millisecondes.
VITE_EXPIRY_SWEEP_INTERVAL_MS=10000
# TTL appliqué par défaut à un SET sans EX explicite, en secondes (0 = désactivé).
VITE_DEFAULT_TTL_SECONDS=0

# Ordre du B-Tree (keyIndex/timeIndex/rangeIndex).
VITE_BTREE_DEGREE=3
# Taille du channel de notification interne du moteur.
VITE_CHANGES_BUFFER_SIZE=4096

# Taille de page du scroll infini côté React (InfiniteList), indépendante du moteur.
VITE_PAGE_SIZE=100

